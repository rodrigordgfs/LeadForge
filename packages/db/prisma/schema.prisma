generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SearchJobStatus {
  pending
  running
  completed
  failed
}

enum LeadStatus {
  novo
  em_contato
  interessado
  proposta_enviada
  negociacao
  fechado
  perdido
}

enum ArtifactType {
  company_txt
  analysis_txt
  website_brief_txt
  proposal_pdf
  diagnosis_pdf
  wireframe_pdf
}

enum ScoreBand {
  critical
  low
  medium
  excellent
}

model User {
  id           String   @id
  name         String
  email        String   @unique
  avatar       String?
  role         String   @default("user")
  settingsJson Json     @default("{}")
  createdAt    DateTime @default(now())

  searchJobs SearchJob[]
  leads      Lead[]
}

model SearchJob {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  segmentId     String
  subcategoryId String?
  state         String
  city          String
  radiusKm      Int             @default(10)
  filtersJson   Json?
  status        SearchJobStatus @default(pending)
  progressPct   Int             @default(0)
  totalFound    Int             @default(0)
  errorMessage  String?
  createdAt     DateTime        @default(now())
  completedAt   DateTime?

  leads Lead[]

  @@index([userId, createdAt(sort: Desc)])
}

model Lead {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchJobId           String
  searchJob             SearchJob   @relation(fields: [searchJobId], references: [id], onDelete: Cascade)
  name                  String
  category              String
  address               String
  city                  String
  state                 String
  phone                 String?
  whatsapp              String?
  email                 String?
  website               String?
  instagram             String?
  facebook              String?
  rating                Float?
  reviewCount           Int?
  mapsUrl               String
  score                 Int?
  scoreBand             ScoreBand?
  hasRealWebsite        Boolean     @default(false)
  diagnosisJson         Json?
  status                LeadStatus  @default(novo)
  autoPipelineTriggered Boolean     @default(false)
  diagnosedAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  contacts  Contact[]
  proposals Proposal[]
  artifacts Artifact[]
  prompts   Prompt[]

  @@index([userId, status])
  @@index([searchJobId])
  @@index([score])
}

model Contact {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  date        DateTime
  notes       String
  status      String
  nextContact DateTime?
  createdAt   DateTime  @default(now())
}

model Proposal {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  value        Decimal  @db.Decimal(12, 2)
  monthlyFee   Decimal? @db.Decimal(12, 2)
  scope        String
  deadline     String
  status       String
  observations String?
  createdAt    DateTime @default(now())
}

model Artifact {
  id            String       @id @default(cuid())
  leadId        String
  lead          Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type          ArtifactType
  filename      String
  mimeType      String
  contentBase64 String       @db.Text
  sizeBytes     Int
  createdAt     DateTime     @default(now())

  @@index([leadId, type])
}

model Prompt {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
}
