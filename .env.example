# Database
DATABASE_URL=postgresql://leadforge:leadforge@localhost:5434/leadforge

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Clerk Auth
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# OpenAI
OPENAI_API_KEY=

# Google PageSpeed Insights
GOOGLE_PSI_API_KEY=

# Application
HIGH_OPPORTUNITY_THRESHOLD=60
SCRAPER_MAX_RESULTS=120
SCRAPER_CONCURRENCY=2

# Playwright (Docker sets PLAYWRIGHT_BROWSERS_PATH=0 in docker-compose.yml)
# Local dev: run `pnpm --filter @leadforge/worker setup:playwright` once after install
