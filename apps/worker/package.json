{
  "name": "@leadforge/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "postinstall": "playwright install chromium",
    "setup:playwright": "bash scripts/setup-playwright.sh",
    "start": "node --env-file=../../.env dist/index.js",
    "test": "vitest run",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@leadforge/db": "workspace:*",
    "@leadforge/queue": "workspace:*",
    "@leadforge/shared": "workspace:*",
    "@react-pdf/renderer": "^4.2.0",
    "bullmq": "^5.34.8",
    "openai": "^4.77.0",
    "playwright": "^1.60.0",
    "react": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "linkedom": "^0.18.9",
    "vitest": "^2.1.8"
  }
}
